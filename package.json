{
  "name": "cairn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cairn \u2014 a claim verification desk that shows its sources.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/test/*.test.js",
    "test:live": "node server/test/live.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/azeret-mono": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "cheerio": "^1.0.0",
    "express": "^5.1.0",
    "puppeteer-core": "^23.11.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nassami1/cairn.git"
  },
  "homepage": "https://github.com/Nassami1/cairn#readme",
  "bugs": {
    "url": "https://github.com/Nassami1/cairn/issues"
  }
}
