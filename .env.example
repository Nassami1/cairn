# Cairn works without any of these. They are optional upgrades.

# Server
PORT=8787
HOST=127.0.0.1

# A contact address for polite API use (Wikimedia user agent, OpenAlex mailto).
# CONTACT_EMAIL=you@example.com

# Optional: OpenAI-compatible synthesis. The verdict and citations are still
# computed and validated server-side; the model only rewrites the summary.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Optional: general web search as a fourth source family.
# BRAVE_API_KEY=
# TAVILY_API_KEY=
